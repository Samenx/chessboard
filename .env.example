# Create a local .env file and set this connection string.
# URI-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/chessboard_press
API_PORT=3001
API_HOST=127.0.0.1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-private-password-at-least-12-chars
# Local testing only. Remove or set to "disabled" outside local test environments.
PAYMENTS_MODE=beta
